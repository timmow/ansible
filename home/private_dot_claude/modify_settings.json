{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merge managed keys into ~/.claude/settings.json, leaving everything else
  (model, permissions.allow, statusLine, ...) exactly as Claude wrote it.
  Order: live file < canonical (public) < work (~/.codex/claude/settings.json).
  Maps merge recursively; lists (hooks, sandbox lists) are replaced whole.
*/ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin | trim -}}{{- $live = .chezmoi.stdin | fromJson -}}{{- end -}}
{{- $base := includeTemplate "canonical_claude_settings.json" . | fromJson -}}
{{- $workPath := joinPath .chezmoi.homeDir ".codex/claude/settings.json" -}}
{{- $work := dict -}}
{{- if stat $workPath -}}{{- $work = include $workPath | fromJson -}}{{- end -}}
{{- mergeOverwrite (dict) $live $base $work | toPrettyJson "  " | replace "$HOME" .chezmoi.homeDir }}
